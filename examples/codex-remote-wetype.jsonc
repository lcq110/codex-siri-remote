// Codex Remote profile with Siri Remote Mic + WeType voice input.
// WeType voice input: hold Fn to speak; the keyboard toggle can stay Fn+Space.
// In Codex, hold Play/Pause for 0.5 s and release to switch to VocoType.
{
  "settings": {
    "defaultMode": "global",
    "circularScroll": {
      "enabled": true,
      "minRadius": 0.35,
      "startThreshold": 0.2,
      "pixelsPerRadian": 75,
      "scrollEase": 0.3,
      "invert": true,
      "accelMin": 0.7,
      "accelMax": 4.0,
      "accelHighSpeed": 0.05
    }
  },

  "appProfiles": {
    "com.openai.codex": "codex",
    "com.google.Chrome": "chrome",
    "default": "global"
  },

  "modes": {
    "global": {
      "ring.up":    { "action": "keystroke", "keys": "up" },
      "ring.down":  { "action": "keystroke", "keys": "down" },
      "ring.left":  { "action": "keystroke", "keys": "left" },
      "ring.right": { "action": "keystroke", "keys": "right" },

      "button.menu":      { "action": "workflow", "intent": "toggleCodexPreviousApp" },
      "button.siri":      { "action": "holdToTalk", "keys": "fn" },
      "button.tv+siri":   { "action": "holdToTalk", "keys": "fn" },
      "button.siri.tap":  { "action": "keystroke", "keys": "opt+delete" },
      "button.tv":        { "action": "keystroke", "keys": "return" },
      "button.tv.double": { "action": "workflow", "intent": "interrupt" }
    },

    "codex": {
      "inherits": "global",
      "ring.left":    { "action": "keystroke", "keys": "cmd+[" },
      "ring.right":   { "action": "keystroke", "keys": "cmd+]" },
      "button.playPause": { "action": "keystroke", "keys": "cmd+b" },
      "button.playPause.hold": { "action": "shell", "command": "$HOME/.config/siriremote/toggle-voice-engine.sh", "after": 0.5 }
    },

    "chrome": {
      "inherits": "global"
    }
  }
}
